{
  "name": "news-card-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a news link into a clean, citable card for your slides.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "web",
    "proxy"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:html": "node scripts/check-no-innerhtml.ts",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w proxy && tsc --noEmit -p scripts",
    "test": "npm run test -w web && npm run test -w proxy",
    "e2e": "npm run e2e -w web",
    "smoke": "node scripts/smoke.ts",
    "registry:check": "node scripts/registry-check.ts",
    "screenshots": "node scripts/screenshots.ts",
    "inspect": "node scripts/inspect.ts",
    "capture-fixture": "node scripts/capture-fixture.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
